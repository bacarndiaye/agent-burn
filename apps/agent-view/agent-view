 toast(`${j.ok} message(s) traité(s)`+(j.erreurs&&j.erreurs.length?` · ${j.erreurs.length} refusé(s) : ${j.erreurs[0]}`:""));
 await charger()}
document.addEventListener("click",ev=>{const b=ev.target.closest("button[data-act]");if(!b)return;
