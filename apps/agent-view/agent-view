# ----------------------------------------- consommation & quotas : alimentées par agent-burn --
# agent-burn lit les journaux locaux (Claude Code, Codex…) et calcule un coût équivalent API, la valeur des
# abonnements et les limites 5 h / 7 j. Ses scans sont lents (dizaines de secondes sur un gros historique) : ils
# tournent dans un fil d'arrière-plan, la page affiche la dernière donnée et son âge, jamais une attente.

AB_CONF = CONF["agent_burn"]
CLASSES = ["gratuit", "abonnement", "payant", "autre"]
NOM_CLASSE = {"gratuit": "gratuit (modèles locaux)", "abonnement": "abonnement", "payant": "payant", "autre": "autre"}
COULEUR_CLASSE = {"gratuit": "#22c55e", "abonnement": "#f59e0b", "payant": "#ec4899", "autre": "#8089a0"}
_JETON = re.compile(r"(Bearer\s+|sk-[A-Za-z0-9-]*|ghp_)[A-Za-z0-9._\-]+")


def binaire_burn():
    b = os.environ.get("AV_AGENT_BURN") or os.path.expanduser(AB_CONF.get("binaire") or "~/.local/bin/agent-burn")
    return b if os.path.isfile(b) and os.access(b, os.X_OK) else None


def classe_modele(m):
    """gratuit = modèle servi par un moteur local (table « modeles » : local / strata) ; sinon préfixes « classes »."""
    ml = (m or "").lower()
    if MOTEURS.get(ml) in ("local", "strata"):
        return "gratuit"
    for cl in ("abonnement", "payant"):
        if any(ml.startswith(p.lower()) for p in CONF["classes"].get(cl, [])):
            return cl
    return "autre"


def _burn(args, timeout, quota_only=False):
    b = binaire_burn()
    if not b:
        raise RuntimeError("agent-burn introuvable ($AV_AGENT_BURN ou ~/.local/bin/agent-burn)")
    cmd = [b, *args]
    cfg = os.path.expanduser(AB_CONF.get("config") or "")
    if cfg and os.path.isfile(cfg):
        cmd += ["--config", cfg]
    env = dict(os.environ, NO_COLOR="1")
    if quota_only:
        env["AGENT_BURN_QUOTA_ONLY"] = "1"
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"agent-burn {' '.join(args[:2])} : plus de {timeout} s") from None
    if r.returncode != 0:
        msg = _JETON.sub(r"\1***", (r.stderr or r.stdout or "").strip())[-300:]
        raise RuntimeError(f"agent-burn {' '.join(args[:2])} : code {r.returncode} {msg}")
    return json.loads(r.stdout)


def _reset_ms(fenetre, observe):
    """Heure de remise à zéro d'une fenêtre de quota, déduite du temps écoulé (agent-burn n'en donne pas toujours)."""
    try:
        reste = (100.0 - float(fenetre["elapsedPercent"])) / 100.0 * float(fenetre["windowMinutes"]) * 60000
        return int(observe + reste)
    except (KeyError, TypeError, ValueError):
        return None


def collect_quotas():
    """Limites 5 h / 7 j de Claude et Codex (mode QUOTA_ONLY d'agent-burn : 1-2 s, sans scan des journaux)."""
    out = {}
    for agent in ("claude", "codex"):
        try:
            q = _burn(["harness", agent, "--json"], 60, quota_only=True)
        except Exception as e:
            out[agent] = {"erreur": str(e)}
            continue
        obs = q.get("observedAt") or int(time.time() * 1000)
        fen = []
        for cle, nom in (("sessionWindow", "5 h"), ("window", None)):
            f = q.get(cle)
            if not f:
                continue
            minutes = f.get("windowMinutes") or 0
            fen.append({"nom": nom or ("7 j" if minutes == 10080 else f"{round(minutes / 1440)} j" if minutes >= 1440 else f"{minutes} min"),
                        "utilise": f.get("usedPercent"), "ecoule": f.get("elapsedPercent"),
                        "reset_ms": _reset_ms(f, obs)})
        out[agent] = {"observe_ms": obs, "fenetres": fen}
    out["glm"] = {"erreur": "quota GLM non exposé par agent-burn"}
    return out


def collect_conso():
    periode = AB_CONF.get("periode") or "month"
    s = _burn(["summary", periode, "--json", "--breakdown", "--value"], 900)
    dm = s.get("dailyModels") or {}
    modeles = [m.get("model", "") for m in dm.get("models", [])]
    cl_mod = [classe_modele(m) for m in modeles]
    jours = []
    for d in (dm.get("history") or {}).get("days", []):
        cout = {c: 0.0 for c in CLASSES}
        tok = {c: 0 for c in CLASSES}
        for i, c in enumerate(cl_mod):
            cout[c] += (d.get("mc") or [0] * len(cl_mod))[i] or 0
            tok[c] += (d.get("mt") or [0] * len(cl_mod))[i] or 0
        jours.append({"d": d.get("d"), "cout": cout, "tokens": tok})
    tot_tok = {c: sum(j["tokens"][c] for j in jours) for c in CLASSES}
    tot_cout = {c: sum(j["cout"][c] for j in jours) for c in CLASSES}

    def part(js):
        t = sum(sum(j["tokens"].values()) for j in js)
        return round(100.0 * sum(j["tokens"]["gratuit"] for j in js) / t, 1) if t else None

    # coût évité : tokens gratuits valorisés au prix moyen du token payant sur la période (approximation affichée)
    prix_moyen = tot_cout["payant"] / tot_tok["payant"] if tot_tok["payant"] else 0.0
    top = sorted(({"modele": m.get("model"), "classe": classe_modele(m.get("model")), "cout": m.get("totalCost") or 0,
                   "tokens": m.get("totalTokens") or 0} for m in s.get("models", [])), key=lambda x: -x["tokens"])[:15]
    abonnements = []
    for a in (s.get("subscription") or {}).get("agents", []):
        est, fen, court = a.get("estimate") or {}, a.get("window") or {}, a.get("shortWindow") or {}
        abonnements.append({"agent": a.get("agent"), "plan": a.get("plan"), "prix_mois": a.get("pricePerMonth"),
                            "usage_periode": a.get("periodUsage"), "valeur_mois": est.get("monthlyValue"),
                            "multiple": est.get("valueMultiple"), "fenetre": fen.get("label"), "fenetre_pct": fen.get("usedPercent"),
                            "court": court.get("label"), "court_pct": court.get("usedPercent")})
    compte = s.get("claudeAccount") or {}
    resets = {"5 h": compte.get("sessionResetsAtMs"), "7 j": compte.get("weeklyResetsAtMs")}
    return {"periode": periode, "jours": jours, "tot_tokens": tot_tok, "tot_cout": tot_cout,
            "part_gratuite": {"periode": part(jours), "j7": part(jours[-7:]), "auj": part(jours[-1:])},
            "evite_usd": round(tot_tok["gratuit"] * prix_moyen, 2), "prix_moyen_mtok": round(prix_moyen * 1e6, 4),
            "total_usd": round((s.get("totals") or {}).get("totalCost") or 0, 2),
            "top": top, "abonnements": abonnements, "resets_claude": resets,
            "classes": [{"cle": c, "nom": NOM_CLASSE[c], "couleur": COULEUR_CLASSE[c]} for c in CLASSES]}


class CacheFond:
    """Calcul lent en arrière-plan ; get() n'attend JAMAIS : dernière donnée + âge, ou « en cours » au démarrage.
    Après un échec, nouvel essai au plus tôt `pause` s plus tard (un binaire absent ne relance pas en boucle)."""

    def __init__(self, fn, every, pause=120):
        self.fn, self.every, self.pause = fn, every, pause
        self.data, self.t, self.t_essai, self.err = None, 0.0, 0.0, ""
        self.lock = threading.Lock()

    def _run(self):
        if not self.lock.acquire(blocking=False):
            return
        self.t_essai = time.time()
        try:
            self.data, self.t, self.err = self.fn(), time.time(), ""
        except Exception as e:
            self.err = str(e)[:400]
        finally:
            self.lock.release()

    def get(self, attendre=False):
        maintenant = time.time()
        perime = self.data is None or maintenant - self.t > self.every
        if perime and not self.lock.locked() and maintenant - self.t_essai > (self.pause if self.err else 0):
            if attendre:
                self._run()
            else:
                threading.Thread(target=self._run, daemon=True).start()
        return {"data": self.data, "age": int(maintenant - self.t) if self.data is not None else None,
                "calcul": self.lock.locked(), "erreur": self.err}


CONSO = CacheFond(collect_conso, 600)
QUOTAS = CacheFond(collect_quotas, 120)


