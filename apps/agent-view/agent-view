.q .u{height:100%;border-radius:999px}.q .e{position:absolute;top:-2px;bottom:-2px;width:2px;background:var(--txt);opacity:.55}
.err{color:var(--bad);font-size:12.5px}.vide{color:var(--dim);padding:10px 0}
footer{grid-column:1/-1;color:var(--dim);font-size:12px;line-height:1.6}
</style></head><body>
<header><h1>📊 Conso & quotas</h1><nav><a href="/">← Bureaux</a><a href="/liens">Liens</a><a href="/worktrees">Worktrees</a></nav><div id="maj">chargement…</div></header>
<main>
 <div class="panel large"><div id="cards"></div></div>
 <div class="panel large"><h2>Coût équivalent API par jour</h2><svg id="gcout" viewBox="0 0 700 150" preserveAspectRatio="none"></svg><div class="leg" id="lcout"></div></div>
 <div class="panel large"><h2>Tokens par jour</h2><svg id="gtok" viewBox="0 0 700 150" preserveAspectRatio="none"></svg><div class="leg" id="ltok"></div></div>
 <div class="panel"><h2>Limites d'abonnement</h2><div id="quotas"></div></div>
 <div class="panel"><h2>Abonnements</h2><div id="abos"></div></div>
