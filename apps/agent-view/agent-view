CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def pur(s):
    """Texte venu du bus ou d'un nom de dossier, sans caractères de contrôle (séquences ESC/OSC en terminal)."""
    return CTRL.sub("", str(s if s is not None else ""))


def lire(f, limite=None):
    """read_text tolérant (UTF-8 invalide remplacé) ; limite = octets lus au plus."""
    with open(f, encoding="utf8", errors="replace") as fh:
        return fh.read(limite) if limite else fh.read()


def newest_mtime(paths, limit=12, needle=None):
    """mtime du fichier le plus récent parmi les `limit` plus récents de chaque entrée.

    needle : si plusieurs agents vivants partagent le même dossier de transcripts, le
    mtime max du dossier est ambigu (il reflète l'ACTIVITÉ D'UN AUTRE). On cherche alors
    l'id de l'agent DANS les jsonl récents (le prompt d'agent-msg porte l'identité) et on
    prend le plus récent qui matche."""
    best = 0.0
    for p in paths:
        try:
            if p.is_file():
                best = max(best, p.stat().st_mtime)
            elif p.is_dir():
                files = sorted(p.iterdir(), key=lambda x: x.stat().st_mtime if x.is_file() else 0, reverse=True)
                if needle:
                    for f in files[:limit]:
                        try:
                            if f.is_file() and needle in _tete_queue(f):
                                best = max(best, f.stat().st_mtime)
                                break
                        except OSError:
                            pass
                    continue
                for f in files[:limit]:
                    try:
                        best = max(best, f.stat().st_mtime)
                    except OSError:
                        pass
        except OSError:
            pass
    return best


def _tete_queue(f, n=65536):
    """Début et fin d'un jsonl (l'identité de l'agent est dans le 1er prompt et dans les messages récents)."""
    with open(f, "rb") as fh:
        tete = fh.read(n)
        try:
            fh.seek(-n, os.SEEK_END)
        except OSError:
            return tete.decode("utf8", "replace")
        return (tete + fh.read()).decode("utf8", "replace")


def sup_transcript(pid):
    """transcript_path du statusline.json de sup-failover pour ce pid (superviseurs Claude Code)."""
    if SUPCACHE.is_dir():
        for d in SUPCACHE.iterdir():
            if d.is_dir() and d.name.endswith(f"-{pid}"):
                f = d / "statusline.json"
                if f.is_file():
                    try:
                        return json.loads(lire(f)).get("transcript_path")
                    except Exception:
                        return None
    return None


def worktree_recent(worktree):
    """une écriture < 2 min dans le worktree ? (find -quit, plafonné à 2 s)"""
    try:
        if not worktree or not os.path.isdir(worktree):
            return False
        r = subprocess.run(["find", str(worktree), "(", "-name", ".git", "-o", "-path", "*/.claude/worktrees", "-o",
                            "-name", "node_modules", ")", "-prune", "-o", "-type", "f", "-mmin", "-2", "-print", "-quit"],
                           capture_output=True, timeout=2)
        return r.returncode == 0 and r.stdout.strip() != b""
    except Exception:
        return False


def pid_start(pid):
    """Champ 22 de /proc/<pid>/stat (démarrage, en tops d'horloge depuis le boot) ou None."""
    try:
        st = open(f"/proc/{int(pid)}/stat").read()
        return int(st[st.rindex(")") + 2:].split()[19])
    except (OSError, ValueError, IndexError):
        return None


START_KEYS = ("pid_start", "pidstart", "start_ticks", "starttime", "pid_starttime", "start")


def alive(pid, start=None):
    """pid vivant ; si le registre donne l'heure de démarrage du pid, elle doit correspondre (pid réutilisé = fini)."""
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
    except (ValueError, ProcessLookupError):
        return False
    except PermissionError:
        pass
    try:
        st = open(f"/proc/{int(pid)}/stat").read()
        if st[st.rindex(")") + 2:].split()[0] == "Z":
            return False                     # zombie : le processus est mort, seul son parent ne l'a pas récolté
    except (OSError, ValueError, IndexError):
        pass
    if start and str(start).isdigit():
        reel = pid_start(pid)
        if reel is not None and reel != int(start):
            return False
    return True


def reg_alive(reg):
    return alive(reg.get("pid", ""), next((reg[k] for k in START_KEYS if reg.get(k)), None))


