def auxiliaire(argv):
    """Processus claude/codex qui n'est pas un agent : sous-commande utilitaire, --version, hôtes et démons."""
    if any(AUX_BIN.search(x) for x in argv[:2]):
        return True
    pos = [x for x in argv[1:] if not x.startswith("-")]
    return (bool(pos) and pos[0] in SOUS_CMD_AUX and argv[1] == pos[0]) or (len(argv) == 2 and argv[1] in ("--version", "-v"))


def rollouts_ouverts(pid):
    """Rollouts Codex tenus ouverts par le processus (Codex garde son journal de session ouvert)."""
    out = []
    try:
        for fd in os.listdir(f"/proc/{pid}/fd"):
            try:
                cible = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if "/.codex/sessions/" in cible and cible.endswith(".jsonl"):
                out.append(cible)
    except OSError:
        pass
    return out


def session_de(argv):
    """Identifiant de session Claude Code passé en ligne de commande (--session-id / --resume / -r)."""
    for i, x in enumerate(argv[:-1]):
        if x in ("--session-id", "--resume", "-r") and re.fullmatch(r"[0-9a-f-]{36}", argv[i + 1]):
            return argv[i + 1]
    return None
WT_SEP = "/.claude/worktrees/"


MODELES_MOTEUR = {k.lower(): v for k, v in CONF["modeles"].items()}


def moteur_cmd(cmd):
    """Moteur repéré dans la ligne de commande (ex. fournisseur Codex d'un modèle local), sinon None."""
    for moteur, motifs in CONF["moteurs_cmd"].items():
        if any(x and x in cmd for x in motifs):
            return moteur
    return None


def _moteur_url(base, modele):
    """Moteur déduit de l'endpoint Anthropic-compatible d'un processus claude (ou None : abonnement)."""
    b, m = (base or "").lower(), (modele or "").lower()
    if m in MODELES_MOTEUR:
        return MODELES_MOTEUR[m]
    for moteur, motifs in CONF["moteurs_url"].items():
        if any(x and x.lower() in b for x in motifs):
            return moteur
    if m.startswith("glm"):
        return "glm"
    return None


def processus_agents():
    """{pid: infos} des processus claude / codex (hors auxiliaires) : ppid, cwd, démarrage, AGENT_ID, moteur.
    Une seule lecture de /proc toutes les 6 s ; les shells et serveurs MCP ne sont pas lus."""
    now = time.time()
    if now - _PROC_CACHE["t"] < 6:
        return _PROC_CACHE["v"]
    procs, tous, cpu = {}, {}, {}
    try:
        pids = [int(d) for d in os.listdir("/proc") if d.isdigit()]
    except OSError:
        pids = []
    for p in pids:
        try:
            st = open(f"/proc/{p}/stat").read()
            champs = st[st.rindex(")") + 2:].split()
            tous[p] = int(champs[1])
            cpu[p] = int(champs[11]) + int(champs[12])          # utime + stime
            debut = BOOT + int(champs[19]) / CLK
            argv = [x.decode("utf8", "replace") for x in open(f"/proc/{p}/cmdline", "rb").read().split(b"\0") if x]
        except (OSError, ValueError, IndexError):
            continue
        if not argv:
            continue
        tete = [x for x in argv[:2] if not x.startswith("-")]
        if not any(AGENT_BIN.search(x) for x in tete) or auxiliaire(argv):
            continue
        try:
            cwd = os.readlink(f"/proc/{p}/cwd")
            raw = open(f"/proc/{p}/environ", "rb").read()
            t = debut
        except OSError:
            continue
        env = {}
        for kv in raw.split(b"\0"):
            k, _, v = kv.partition(b"=")
            if k in (b"AGENT_ID", b"ANTHROPIC_BASE_URL", b"ANTHROPIC_MODEL"):
                env[k.decode()] = v.decode("utf8", "replace")
        cmd = " ".join(argv)
        m = _moteur_url(env.get("ANTHROPIC_BASE_URL"), env.get("ANTHROPIC_MODEL"))
        if m is None:
            m = moteur_cmd(cmd) or ("codex" if any("codex" in x for x in tete) else "claude")
        procs[p] = {"pid": p, "ppid": tous[p], "cwd": cwd, "start": t, "agent_id": env.get("AGENT_ID", ""),
                    "moteur": m, "declare": bool(env.get("ANTHROPIC_BASE_URL")) or bool(moteur_cmd(cmd)), "cmd": cmd[:160],
                    "sid": session_de(argv), "rollouts": rollouts_ouverts(p) if m == "codex" else []}
    for p, d in procs.items():
        d["ppids"] = []                       # ascendance (pid vers la racine), pour rattacher un processus à un agent enregistré
        q, n = d["ppid"], 0
        while q > 1 and n < 12:
            d["ppids"].append(q)
            q, n = tous.get(q, 0), n + 1
    _PROC_CACHE.update(t=now, v=procs, cpu=cpu, ppid=tous)
    return procs


def cpu_par_agent(regpids):
    """{pid enregistré: tops CPU de son arbre}, chaque processus compté pour l'agent enregistré le plus PROCHE
    (un superviseur n'hérite pas du CPU de ses développeurs, qui ont leur propre inscription)."""
    tous, cpu, out = _PROC_CACHE["ppid"], _PROC_CACHE["cpu"], {}
    for p, c in cpu.items():
        q, n = p, 0
        while q > 1 and n < 16:
            if q in regpids:
                out[q] = out.get(q, 0) + c
                break
            q, n = tous.get(q, 0), n + 1
    return out


def jsonl_de(procs, agent_id, regpid):
    """Transcript de l'agent d'après la session de SON processus claude (descendant du pid enregistré, sinon
    processus portant son AGENT_ID) : <dossier du cwd>/<session>.jsonl. None si inconnu."""
    try:
        rp = int(regpid)
    except (TypeError, ValueError):
        rp = 0
    cand = [d for d in procs.values() if d.get("sid") and (rp in d["ppids"] or d["pid"] == rp or d["agent_id"] == agent_id)]
    cand.sort(key=lambda d: (d["ppids"].index(rp) if rp in d["ppids"] else 99, -d["start"]))
    for d in cand:
        f = transcript_dir(d["cwd"]) / f"{d['sid']}.jsonl"
        if f.is_file():
            return f
    codex = [d for d in procs.values() if d["rollouts"] and (rp in d["ppids"] or d["pid"] == rp or d["agent_id"] == agent_id)]
    fichiers = [Path(r) for d in codex for r in d["rollouts"]]
    return max(fichiers, key=lambda f: f.stat().st_mtime if f.exists() else 0) if fichiers else None


def moteur_reel(procs, agent_id, regpid):
    """Moteur d'un agent d'après SON processus claude : le fils direct du pid enregistré (le superviseur basculé de GLM sur
    modèle local reste « glm » dans le bus), sinon le descendant le plus proche, sinon le plus récent portant son AGENT_ID.
    Un `claude -p` lancé à la main par un superviseur hérite de son AGENT_ID mais ne le définit pas."""
    cand = [d for d in procs.values() if d["agent_id"] == agent_id and d["declare"]]
    if not cand:
        return None
    try:
        rp = int(regpid)
    except (TypeError, ValueError):
        rp = 0

    def rang(d):
        prof = d["ppids"].index(rp) if rp in d["ppids"] else 99
        return (prof, -d["start"])
    return min(cand, key=rang)["moteur"]


def hors_bus(procs, regs):
    """Développeurs/agents lancés sans passer par dev-agent : processus claude/codex dans un worktree qu'aucun agent
    enregistré vivant ne couvre. Un enregistrement synthétique par worktree (id « hors-bus-<worktree> »)."""
    def racine(wt):
        return wt.split(WT_SEP, 1)[0] + WT_SEP + wt.split(WT_SEP, 1)[1].split("/")[0] if WT_SEP in wt else None
    couverts, pids_reg = set(), set()
    for r in regs:
        if reg_alive(r):
            if racine(r.get("worktree", "")):
                couverts.add(racine(r["worktree"]))
            if str(r.get("pid", "")).isdigit():
                pids_reg.add(int(r["pid"]))
    par_wt = {}
    for d in procs.values():
        rac = racine(d["cwd"])
        if not rac or rac in couverts or d["pid"] in pids_reg or pids_reg & set(d["ppids"]):
            continue
        if rac not in par_wt or d["start"] < par_wt[rac]["start"]:
            par_wt[rac] = d                    # le plus ancien = le processus principal
    out = []
    ids = {r["__id"]: r for r in regs}
    for rac, d in sorted(par_wt.items()):
        pere = d["agent_id"] if d["agent_id"] in ids else ""
        out.append({"__id": "hors-bus-" + os.path.basename(rac), "role": "dev", "harness": d["moteur"], "worktree": rac,
                    "parent": pere, "pid": str(d["pid"]), "since": time.strftime("%Y%m%dT%H%M%S", time.localtime(d["start"])),
                    "__hors_bus": True})
    return out


def creneaux():
    """{moteur: {total, pris, libres}} : verrous flock tenus par les dev-agent. /proc/locks ne montre pas les verrous
    dont le détenteur est hors de l'espace de noms (pid 0) : on lit les fdinfo des seuls dev-agent, sans rien verrouiller.
    Total = DEV_AGENT_<MOTEUR>_SLOTS (même source que dev-agent / engine-check), relevé au nombre de verrous tenus si
    un superviseur a lancé ses développeurs avec une valeur plus haute. Mis en cache 6 s."""
    if time.time() - _CRENEAUX_CACHE["t"] < 6:
        return _CRENEAUX_CACHE["v"]
    pris_inodes = set()
    try:
        pids = [d for d in os.listdir("/proc") if d.isdigit()]
    except OSError:
        pids = []
    for p in pids:
        try:
            if b"dev-agent" not in open(f"/proc/{p}/cmdline", "rb").read():
                continue
            fds = os.listdir(f"/proc/{p}/fdinfo")
        except OSError:
            continue
        for fd in fds:
            try:
                txt = open(f"/proc/{p}/fdinfo/{fd}").read()
            except OSError:
                continue
            if "\nlock:" in txt and "FLOCK" in txt:
                m = re.search(r"^ino:\s+(\d+)", txt, re.M)
                if m:
                    pris_inodes.add(int(m.group(1)))
    out = {}
    if not DEVLOCKS.is_dir():        # poste sans dev-agent : pas de créneaux à afficher
        return out
    for m, (pre, n) in CRENEAUX.items():
        if DOSSIER_CLES and m in CLES and not (DOSSIER_CLES / CLES[m]).exists():
            continue                       # moteur non configuré sur ce poste : rien à compter
        pris = 0
        for i in range(1, max(n, 8) + 1):
            try:
                if (DEVLOCKS / f"{pre}{i}.lock").stat().st_ino in pris_inodes:
                    pris += 1
            except OSError:
                pass
        total = max(n, pris)
        out[m] = {"total": total, "pris": pris, "libres": total - pris}
    _CRENEAUX_CACHE.update(t=time.time(), v=out)
    return out


def collect():
    now = time.time()
    procs = processus_agents()
    agents = []
    regs = []
    regs += registre_agents()
    regs += hors_bus(procs, regs)
    # cwd partagés par plusieurs vivants → activité désambiguïsée par l'id dans le transcript
    vivants = {r["__id"]: reg_alive(r) for r in regs}
    partage = {}
    for reg in regs:
        if vivants[reg["__id"]]:
            d = str(transcript_dir(reg.get("worktree", "")))
            partage[d] = partage.get(d, 0) + 1
    regpids = {int(r["pid"]) for r in regs if vivants[r["__id"]] and str(r.get("pid", "")).isdigit()}
    cpu = cpu_par_agent(regpids)
    for reg in regs:
        f_id = reg["__id"]
        pid = reg.get("pid", "")
        wt = reg.get("worktree", "")
        is_alive = vivants[f_id]
        act, cpu_actif = 0.0, False
        if is_alive:                       # un agent fini n'est plus observé : aucune lecture de transcript
            tp = sup_transcript(pid)
            propre = Path(tp) if tp else jsonl_de(procs, f_id, pid)
            if propre is not None:
                act = newest_mtime([propre])
            else:
                td = transcript_dir(wt)
                needle = f_id if partage.get(str(td), 0) > 1 else None
                act = newest_mtime([td] if td.is_dir() else [], needle=needle)
            if pid.isdigit() and int(pid) in cpu:
                t_prev, c_prev = _CPU_PREV.get(int(pid), (None, None))
                if t_prev and now > t_prev:
                    cpu_actif = (cpu[int(pid)] - c_prev) / CLK / (now - t_prev) >= CPU_ACTIF
                _CPU_PREV[int(pid)] = (now, cpu[int(pid)])
        if is_alive and (now - act < ACTION_S or cpu_actif or worktree_recent(wt)):
            state = "action"
        elif is_alive:
            state = "veille"
        else:
            state = "fini"
        decl = reg.get("harness", "?")
        harness = (moteur_reel(procs, f_id, pid) or decl) if is_alive and not reg.get("__hors_bus") else decl
        agents.append({
            "id": f_id, "role": reg.get("role", "?"), "harness": harness, "harness_declare": decl, "hors_bus": bool(reg.get("__hors_bus")),
            "worktree": wt, "parent": reg.get("parent", ""), "pid": int(pid) if pid.isdigit() else 0,
            "classe": "mgr" if reg.get("role") == "mgr" else "sup" if reg.get("role") == "sup" else "junior" if harness in JUNIOR else "dev",
            "since": reg.get("since", ""), "alive": is_alive, "state": state,
            "activity_ago": max(0, int(now - act)) if act else None,
            "wt_short": os.path.basename(wt.rstrip("/")) or wt,
        })
    # messages : toutes les boîtes (non lus + lus) ; stat de tout, lecture des 40 plus récents seulement
    datés = []
    if (BUS / "inbox").is_dir():
        for f in list((BUS / "inbox").glob("*/*.msg")) + list((BUS / "inbox").glob("*/lu/*.msg")):
            try:
                datés.append((f.stat().st_mtime, f))
            except OSError:
                continue
    datés.sort(key=lambda x: x[0], reverse=True)
    msgs = []
    for mtime, f in datés[:40]:
        try:
            head = lire(f, 4000).split("\n\n", 1)
            fields = dict(l.split("=", 1) for l in head[0].splitlines() if "=" in l)
            msgs.append({"from": fields.get("de", "?"), "to": fields.get("à", "?"),
                         "when": fields.get("quand", ""), "text": (head[1] if len(head) > 1 else "").strip(),
                         "path": str(f), "mtime": mtime, "read": f.parent.name == "lu", "ago": int(now - mtime)})
        except (OSError, ValueError):
            continue
    threads = []
    if (BUS / "threads").is_dir():
        fils = []
        for f in (BUS / "threads").glob("*.md"):
            try:
                fils.append((f.stat().st_mtime, f))
            except OSError:
                continue
        for _, f in sorted(fils, key=lambda x: x[0], reverse=True):
            try:
                lines = lire(f).splitlines()
                last = next((l for l in reversed(lines) if l.strip() and not l.startswith("### ")), "")
                threads.append({"name": f.stem, "ago": int(now - f.stat().st_mtime), "last": last[:120]})
            except OSError:
                continue
    return {"now": int(now), "agents": agents, "messages": msgs, "threads": threads, "slots": creneaux()}


