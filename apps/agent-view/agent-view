def parse_when(s):
    try:
        return datetime.strptime(s, "%Y%m%dT%H%M%S").timestamp()
    except Exception:
        return None


def transcript_dir(worktree):
    """Dossier des transcripts Claude Code d'un cwd : tout caractère hors [A-Za-z0-9-] devient « - »
    (…/projet/.claude/worktrees/x -> -home-…-projet--claude-worktrees-x)."""
