  o.push(`<g class="eg ${k}" data-f="${esc(e.from)}" data-t="${esc(e.to)}" style="--w:${w}"><path class="v" d="${d}" marker-end="url(#ar-${k})"/><path class="h" d="${d}"><title>${esc(e.from)} → ${esc(e.to)} · ${e.n} msg${e.unread?" · "+e.unread+" non lu(s)":""}</title></path></g>`)});
 Object.values(pos).forEach(p=>{
  const n=p.n,id=n.id;
  const bl=(n.unread_in?String(n.unread_in).length+2:0)+(n.unread_out?String(n.unread_out).length+2:0)+(n.unread_in&&n.unread_out?1:0);
  const mx=Math.max(8,Math.floor((p.w-22-bl*7)/(p.head?7.2:6.3))),t=id.length>mx?id.slice(0,mx-1)+"…":id;
  const bd=[];if(n.unread_in)bd.push(`<tspan fill="#f59e0b">✉${n.unread_in}</tspan>`);if(n.unread_out)bd.push(`<tspan fill="#8ab4ff">↗${n.unread_out}</tspan>`);
