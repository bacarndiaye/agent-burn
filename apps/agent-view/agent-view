TARIF_OPUS = {"in": 5.0, "out": 25.0, "cw": 6.25, "cr": 0.50}      # $ par million de tokens (Opus 5.x)
EUR_PAR_USD = float(os.environ.get("AV_EUR_PAR_USD", "0.892"))
MOTEURS = {k.lower(): v for k, v in CONF["modeles"].items()}      # modèle journalisé -> pièce : configuration locale
NOMS_MOTEURS = dict(CONF["noms_moteurs"])


def moteur_de_modele(m):
    """Pièce d'un modèle journalisé : table locale, sinon tout glm-* est GLM ; None = moteur payant (non compté ici)."""
    m = (m or "").lower()
    return MOTEURS.get(m) or ("glm" if m.startswith("glm") and "glm" in NOMS_MOTEURS else None)
COSTS_JSONL = HOME / ".claude" / "metrics" / "costs.jsonl"          # Claude Code : cumul par session
CODEX_SESSIONS = HOME / ".codex" / "sessions"                       # Codex : total_token_usage cumulé
COUTS_DEPUIS = os.environ.get("AV_COUTS_DEPUIS", "2026-09-01")      # les rollouts plus anciens sont ignorés
_FICHIERS_CODEX = {}        # chemin -> (mtime_ns, taille, {(moteur, jour): [in, out, cw, cr]})


def jour_local(ts):
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d")
    except Exception:
        return ts[:10]


def _delta(cur, prev):
    return [max(0, c - p) for c, p in zip(cur, prev)]


def _lire_rollout(path):
    """{(moteur, jour): [entrée hors cache, sortie, écriture cache, lecture cache]} d'un rollout Codex.
    input_tokens y contient le cache lu : on le retranche. Modèle non suivi dès le 1er tour : fichier ignoré."""
    jours, prev, moteur, vu_tour = {}, [0, 0, 0, 0], None, False
    with open(path, encoding="utf8", errors="replace") as f:
        for l in f:
            if '"turn_context"' in l:
                try:
                    o = json.loads(l)
                except ValueError:
                    continue
                m = (o.get("payload") or {}).get("model")
                if m:
                    moteur, vu_tour = moteur_de_modele(m), True
                if moteur is None:
                    return {}                      # gpt-*, etc. : rien à compter ici
            elif moteur and '"token_count"' in l:
                try:
                    o = json.loads(l)
                except ValueError:
                    continue
                p = o.get("payload") or {}
                u = (p.get("info") or {}).get("total_token_usage")
                if p.get("type") != "token_count" or not u:
                    continue
                c = u.get("cached_input_tokens", 0)
                cur = [u.get("input_tokens", 0) - c, u.get("output_tokens", 0), 0, c]
                d = _delta(cur, prev)
                prev = [max(a, b) for a, b in zip(cur, prev)]
                if any(d):
                    t = jours.setdefault((moteur, jour_local(o.get("timestamp", ""))), [0, 0, 0, 0])
                    for i in range(4):
                        t[i] += d[i]
    return jours if vu_tour else {}


def collect_costs():
    from datetime import timedelta
    jours, sessions = {}, {k: set() for k in NOMS_MOTEURS}

    def ajoute(moteur, jour, d):
        t = jours.setdefault((moteur, jour), [0, 0, 0, 0])
        for i in range(4):
            t[i] += d[i]

    # Claude Code : lignes cumulées par session -> on ajoute les écarts, au jour de chaque ligne
    prev = {}
    try:
        for l in COSTS_JSONL.read_text(errors="replace").splitlines():
            try:
                r = json.loads(l)
            except ValueError:
                continue
            m = moteur_de_modele(r.get("model"))
            if not m:
                continue
            cur = [r.get("input_tokens", 0), r.get("output_tokens", 0), r.get("cache_write_tokens", 0), r.get("cache_read_tokens", 0)]
            sid = r.get("session_id", "")
            avant = prev.get(sid, [0, 0, 0, 0])
            d = _delta(cur, avant)
            prev[sid] = [max(a, b) for a, b in zip(cur, avant)]
            if any(d):
                ajoute(m, jour_local(r.get("timestamp", "")), d)
            sessions[m].add("cc-" + sid)
    except OSError:
        pass
    # Codex : un cache par fichier (mtime + taille), seuls les rollouts modifiés sont relus
    if CODEX_SESSIONS.is_dir():
        for p in CODEX_SESSIONS.glob("*/*/*/rollout-*.jsonl"):
            if p.name[8:18] < COUTS_DEPUIS:
                continue
            try:
                st = p.stat()
            except OSError:
                continue
            k = str(p)
            c = _FICHIERS_CODEX.get(k)
            if not c or c[0] != st.st_mtime_ns or c[1] != st.st_size:
                try:
                    c = (st.st_mtime_ns, st.st_size, _lire_rollout(p))
                except OSError:
                    continue
                _FICHIERS_CODEX[k] = c
            for (m, j), d in c[2].items():
                ajoute(m, j, d)
                sessions[m].add("cx-" + k)

    def usd(t):
        return (t[0] * TARIF_OPUS["in"] + t[1] * TARIF_OPUS["out"] + t[2] * TARIF_OPUS["cw"] + t[3] * TARIF_OPUS["cr"]) / 1e6

    aujourdhui = datetime.now().date()
    liste_jours = [(aujourdhui - timedelta(days=i)).strftime("%Y-%m-%d") for i in range(13, -1, -1)]
    moteurs, tot = [], dict(sess=0, inp=0, out=0, cw=0, cr=0, usd=0.0, today_usd=0.0, d7_usd=0.0)
    for cle, nom in NOMS_MOTEURS.items():
        t = [0, 0, 0, 0]
        mes = {j: v for (m, j), v in jours.items() if m == cle}
        for v in mes.values():
            for i in range(4):
                t[i] += v[i]
        e = {"key": cle, "name": nom, "sess": len(sessions[cle]), "inp": t[0], "out": t[1], "cw": t[2], "cr": t[3],
             "usd": usd(t), "today_usd": usd(mes.get(liste_jours[-1], [0, 0, 0, 0])),
             "d7_usd": sum(usd(mes.get(j, [0, 0, 0, 0])) for j in liste_jours[-7:]),
             "first": min(mes) if mes else None, "last": max(mes) if mes else None,
             "jours": [round(usd(mes.get(j, [0, 0, 0, 0])), 2) for j in liste_jours]}
        e["eur"] = e["usd"] * EUR_PAR_USD
        moteurs.append(e)
        for k in ("sess", "inp", "out", "cw", "cr", "usd", "today_usd", "d7_usd"):
            tot[k] += e[k]
    tot["eur"] = tot["usd"] * EUR_PAR_USD
    return {"t": int(time.time()), "tarif": TARIF_OPUS, "eur_par_usd": EUR_PAR_USD, "jours": liste_jours,
            "moteurs": moteurs, "total": tot}


