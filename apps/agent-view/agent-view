  if(e.from===e.to)return false;
  if(ARR==="unread"&&!e.unread)return false;
  if(ARR==="recent"&&!e.unread&&!(e.ago!=null&&e.ago<10800))return false;
  if(q&&!(e.from+" "+e.to).toLowerCase().includes(q))return false;
  return byId[e.from]&&byId[e.to]});
 const need=new Set();E.forEach(e=>{need.add(e.from);need.add(e.to)});
 const vis=D.nodes.filter(n=>need.has(n.id)||garde(n));
 const visIds=new Set(vis.map(n=>n.id)),pos={},cols=[];
