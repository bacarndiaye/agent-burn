C = {"action": "\033[32m", "veille": "\033[33m", "fini": "\033[90m", "b": "\033[1m", "d": "\033[2m", "0": "\033[0m"}
DOT = {"action": "●", "veille": "◐", "fini": "·"}


def ago_txt(s):
    if s is None:
        return "—"
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{'' if s % 60 == 0 else str(s % 60).rjust(2, '0') + 's'}"
    return f"{s // 3600}h{(s % 3600) // 60:02d}"


def render_text(st):
    a = st["agents"]
    n_act = sum(1 for x in a if x["state"] == "action")
    n_vei = sum(1 for x in a if x["state"] == "veille")
    n_fin = sum(1 for x in a if x["state"] == "fini")
    out = [f"{C['b']}AGENTS — {datetime.now():%H:%M:%S}{C['0']}  {C['d']}·{C['0']} "
           f"{C['action']}{n_act} en action{C['0']}, {C['veille']}{n_vei} en veille{C['0']}, {n_fin} finis",
           f"{'ÉTAT':^4} {'AGENT':34} {'RÔLE':5} {'MOTEUR':7} {'ACTIVITÉ':9} WORKTREE"]
    sl = st.get("slots") or {}
    if sl:
        out.insert(1, f"{C['d']}créneaux dev : " + " · ".join(
            f"{m} {v['pris']}/{v['total']} pris" + (f" {C['veille']}(tous libres){C['d']}" if v["pris"] == 0 else "")
            for m, v in sl.items()) + C["0"])
    finis = []
    for x in sorted(a, key=lambda v: ({"action": 0, "veille": 1, "fini": 2}[v["state"]], v["id"])):
        mark = f"{C[x['state']]}{DOT[x['state']]}{C['0']}"
        moi = "  ← moi" if os.environ.get("AGENT_ID") == x["id"] else ""
        out.append(f"{mark:^4} {('⚠ ' if x.get('hors_bus') else '') + pur(x['id']):34} {pur(x['role']):5} {pur(x['harness']):7} "
                   f"{ago_txt(x['activity_ago']):>9} {pur(x['wt_short'])}{moi}")
        if x["state"] == "fini":
            finis.append(x)
    if len(finis) > 8:
        coupe = len(finis) - 8
        out = out[:-coupe]
        out.append(f"{C['d']}… et {coupe} agents finis plus anciens (machine à jour : le bus ne garde que l'état courant){C['0']}")
    out.append("")
    out.append(f"{C['b']}FLUX — derniers messages{C['0']}")
    for m in st["messages"][:15]:
        first = pur((m["text"] or "").splitlines()[0][:70]) if m["text"] else "(vide)"
        lu = "" if m["read"] else f" {C['b']}*(non lu){C['0']}"
        out.append(f"{C['d']}{ago_txt(m['ago']):>5}{C['0']}  {pur(m['from'])} → {pur(m['to'])}: {first}{lu}")
    for t in st["threads"][:5]:
        out.append(f"{C['d']}{ago_txt(t['ago']):>5}{C['0']}  fil {pur(t['name'])}: {pur(t['last'])}")
    if st.get("erreur"):
        out.append(f"{C['veille']}⚠ {pur(st['erreur'])}{C['0']}")
    return "\n".join(out)


