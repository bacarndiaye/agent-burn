# --- cache d'état (mode serve) : collect() est lent (find, lecture de transcripts) et la page l'interroge
# toutes les 3 s. Un fil l'exécute en arrière-plan tant qu'une page est ouverte ; les requêtes lisent le cache.
_CACHE = {"st": None, "t": 0.0, "req": 0.0, "err": ""}
_CACHE_READY = threading.Event()
CACHE_EVERY = 2.0      # secondes entre deux calculs
CACHE_IDLE = 45.0      # sans requête depuis 45 s : on arrête de calculer


def cache_loop():
    while True:
        if time.time() - _CACHE["req"] > CACHE_IDLE and _CACHE_READY.is_set():
            time.sleep(1)
            continue
        try:
            st = collect()
            _CACHE["st"], _CACHE["t"], _CACHE["err"] = st, time.time(), ""
            _CACHE_READY.set()
        except Exception as e:                   # la page l'affiche : plus d'état figé en silence
            _CACHE["err"] = f"{type(e).__name__}: {e}"[:300]
            print("agent-view : collect ->", _CACHE["err"], file=sys.stderr)
            if _CACHE["st"] is None:
                _CACHE["st"], _CACHE["t"] = {"now": int(time.time()), "agents": [], "messages": [], "threads": [], "slots": {}}, time.time()
                _CACHE_READY.set()
        time.sleep(CACHE_EVERY)


def cached_state():
    """État courant depuis le cache, avec les durées (« il y a … ») ramenées à maintenant."""
    _CACHE["req"] = time.time()
    if not _CACHE_READY.wait(60):
        return collect()
    st, age = _CACHE["st"], int(time.time() - _CACHE["t"])
    out = dict(st, now=int(time.time()), cache_age=age, erreur=_CACHE["err"])
    out["agents"] = [dict(a, activity_ago=a["activity_ago"] + age) if a["activity_ago"] is not None else a for a in st["agents"]]
    out["messages"] = [dict(m, ago=m["ago"] + age) for m in st["messages"]]
    out["threads"] = [dict(t, ago=t["ago"] + age) for t in st["threads"]]
    return out


