def resume_burn():
    """Pour le panneau « Part gratuite » de la page principale : None tant qu'agent-burn n'a rien rendu."""
    c = CONSO.get()["data"]
    if not c:
        return None
    j7 = c["jours"][-7:]
    return {"part": c["part_gratuite"], "payant_7j_usd": round(sum(j["cout"]["payant"] for j in j7), 2),
            "abonnement_7j_usd": round(sum(j["cout"]["abonnement"] for j in j7), 2), "evite_usd": c["evite_usd"],
            "periode": c["periode"]}


def render_conso(api):
    B, D, G, R = "\033[1m", "\033[2m", "\033[32m", "\033[0m"
    lignes = [f"{B}CONSOMMATION & QUOTAS{R} {D}(agent-burn){R}"]
    c, k = api["conso"], api["eur_par_usd"]
    if not api["binaire"]:
        return lignes[0] + "\n  agent-burn introuvable : $AV_AGENT_BURN ou ~/.local/bin/agent-burn (voir scripts/install.sh)"
    if c["erreur"] and not c["data"]:
        lignes.append(f"  indisponible : {c['erreur']}")
    d = c["data"]
    if d:
        pg = d["part_gratuite"]
        f = lambda x: "—" if x is None else f"{x:.0f} %"
        lignes.append(f"  période « {d['periode']} » · total équivalent API {d['total_usd']:.0f} $ (≈ {d['total_usd'] * k:.0f} €)")
        lignes.append(f"  {G}part gratuite{R} (tokens) : période {f(pg['periode'])} · 7 j {f(pg['j7'])} · aujourd'hui {f(pg['auj'])}"
                      f" · coût évité ≈ {d['evite_usd']:.0f} $ {D}(au prix moyen du token payant){R}")
        lignes.append(f"  {'jour':<11}" + "".join(f"{x:>13}" for x in ("gratuit Mtok", "abonnement $", "payant $")))
        for j in d["jours"][-14:]:
            lignes.append(f"  {j['d']:<11}{j['tokens']['gratuit'] / 1e6:>13.1f}{j['cout']['abonnement']:>13.2f}{j['cout']['payant']:>13.2f}")
        lignes.append(f"  {B}top modèles{R}")
        for m in d["top"][:10]:
            lignes.append(f"    {m['modele'][:34]:<34} {m['classe']:<11} {m['tokens'] / 1e6:>10.1f} Mtok {m['cout']:>10.2f} $")
        for a in d["abonnements"]:
            v = f" · valeur ≈ {a['valeur_mois']:.0f} $/mois (×{a['multiple']:.1f})" if a.get("valeur_mois") else ""
            prix = f" ({a['prix_mois']:.0f} $/mois)" if a.get("prix_mois") else ""
            lignes.append(f"  abonnement {a['agent']} : {a['plan'] or '?'}{prix}{v}")
        lignes.append(f"  {D}données d'il y a {c['age']} s{R}")
    q = api["quotas"]["data"] or {}
    for agent in ("claude", "codex", "glm"):
        e = q.get(agent) or {}
        if e.get("erreur"):
            lignes.append(f"  limites {agent} : {e['erreur']}")
            continue
        for fn in e.get("fenetres", []):
            r = fn.get("reset_ms")
            quand = datetime.fromtimestamp(r / 1000).strftime("%d/%m %H:%M") if r else "?"
            lignes.append(f"  limites {agent} {fn['nom']:<4} : {fn['utilise'] or 0:5.1f} % utilisé · remise à zéro {quand}")
    return "\n".join(lignes)


