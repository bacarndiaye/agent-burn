  if(c.head){pos[c.head.id]={x,y,w:BW,col:ci,n:c.head,head:true};y+=BH+GAP+4}else{c.ty=y;y+=BH/2+GAP}
  c.items.forEach(n=>{pos[n.id]={x:x+14,y,w:BW-14,col:ci,n};y+=BH+GAP});
  c.bottom=y;H=Math.max(H,y)});
 const W=PADL+Math.max(1,cols.length)*(BW+CG);
 const o=[`<defs>${["n","u","l"].map(k=>`<marker id="ar-${k}" viewBox="0 0 8 8" refX="7" refY="4" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="${k==="n"?"#5b86c9":k==="u"?"#f59e0b":"#ef4444"}"/></marker>`).join("")}</defs>`];
 cols.forEach(c=>{
  if(!c.head)o.push(`<text class="colt" x="${c.x}" y="${c.ty}">Sans superviseur déclaré</text>`);
  else if(c.items.length){const last=c.items[c.items.length-1],p=pos[last.id],hx=c.x+7;
   o.push(`<path class="hier" d="M${hx},${pos[c.head.id].y+BH} V${p.y+BH/2}"/>`);
   c.items.forEach(n=>{const q2=pos[n.id];o.push(`<path class="hier" d="M${hx},${q2.y+BH/2} H${q2.x}"/>`)})}});
