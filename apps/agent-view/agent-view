WT_ORDRE = {"jamais": 0, "retard": 1, "modifs": 2, "sansdistant": 3, "absent": 4, "ok": 5}


def registre_agents():
    out, d = [], BUS / "agents"
    if d.is_dir():
        for f in sorted(d.iterdir()):
            if ".tmp." in f.name or f.name.endswith(".tmp") or not f.is_file():
                continue                     # inscription en cours d'écriture (tmp puis mv) : pas un agent
            reg = {}
            try:
                for line in lire(f).splitlines():
                    if "=" in line:
                        k, _, v = line.partition("=")
                        reg[k] = v
            except OSError:
                continue
            reg["__id"] = f.name
            out.append(reg)
    return out


def _git(path, *args, timeout=20):
    try:
        r = subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def depots_suivis(regs, only=None):
    """git-common-dir -> un dossier de travail du dépôt : dépôts des worktrees du registre, racines_depots/*, AV_REPOS
    (ou seulement `only`, liste de dossiers : mgr-scan ne regarde que le dépôt du manager)."""
    if only:
        cands = list(only)
    else:
        cands = [r.get("worktree", "") for r in regs]
        for racine in CONF["racines_depots"]:
            cands += [str(p) for p in Path(os.path.expanduser(racine)).glob("*")]
        cands += [x for x in os.environ.get("AV_REPOS", "").split(":") if x]
    depots = {}
    for c in cands:
        if c and os.path.isdir(c):
            g = _git(c, "rev-parse", "--path-format=absolute", "--git-common-dir", timeout=5)
            if g and g.strip():
                depots.setdefault(g.strip(), c)
    return depots


def _inspecter(depot, work, b, agents_wt, remotes, base, branches):
    path = b.get("worktree", "")
    sha = b.get("HEAD", "")
    branche = b["branch"].replace("refs/heads/", "") if "branch" in b else None
    upstream, track = branches.get(branche, ("", "")) if branche else ("", "")
    it = {"depot": depot, "chemin": path, "court": os.path.basename(path.rstrip("/")) or path, "branche": branche,
          "detache": branche is None, "sha": sha[:9], "upstream": upstream, "track": track, "non_pousses": 0,
          "vs_base": None, "dirty": 0, "dernier_ts": None, "dernier_msg": "", "agents": [], "agent_vivant": False}
    ags = agents_wt.get(os.path.realpath(path), [])
    it["agents"] = [a["__id"] for a in ags]
    it["agent_vivant"] = any(reg_alive(a) for a in ags)
    if not os.path.isdir(path):
        it["statut"], it["commande"] = "absent", f"git -C {work} worktree prune"
        return it
    it["remote"] = bool(branche and (f"origin/{branche}" in remotes or (upstream and upstream in remotes)))
    n = _git(path, "rev-list", "--count", sha, "--not", "--remotes")
    it["non_pousses"] = int(n) if n and n.strip().isdigit() else 0
    if base:
        n = _git(path, "rev-list", "--count", f"{base}..{sha}")
        it["vs_base"] = int(n) if n and n.strip().isdigit() else None
    s = _git(path, "status", "--porcelain", timeout=40)
    it["dirty"] = len([l for l in (s or "").splitlines() if l.strip()])
    lg = _git(path, "log", "-1", "--format=%ct%x09%s")
    if lg and "\t" in lg:
        ts, _, msg = lg.strip().partition("\t")
        it["dernier_ts"], it["dernier_msg"] = int(ts) if ts.isdigit() else None, msg[:140]
    if not remotes:                          # dépôt sans aucun distant : « pousser » n'a pas de sens
        it["statut"], it["commande"] = "sansdistant", f"git -C {path} remote add origin <url>"
    elif it["non_pousses"] > 0 and not it["remote"]:
        it["statut"] = "jamais"
        it["commande"] = (f"git -C {path} push -u origin {branche}" if branche
                          else f"git -C {path} switch -c <nom> && git -C {path} push -u origin <nom>")
    elif it["non_pousses"] > 0:
        it["statut"], it["commande"] = "retard", f"git -C {path} push"
    elif it["dirty"] > 0:
        it["statut"], it["commande"] = "modifs", f"git -C {path} status"
    else:
        it["statut"], it["commande"] = "ok", ""
    return it


def collect_worktrees(only=None):
    from concurrent.futures import ThreadPoolExecutor
    os.environ["GIT_OPTIONAL_LOCKS"] = "0"           # git status ne réécrit pas l'index des worktrees observés
    regs = registre_agents()
    agents_wt = {}
    for r in regs:
        agents_wt.setdefault(os.path.realpath(r.get("worktree", "")), []).append(r)
    taches, depots_out = [], []
    for gitdir, work in depots_suivis(regs, only).items():
        porc = _git(work, "worktree", "list", "--porcelain", timeout=15) or ""
        blocs, cur = [], {}
        for line in porc.splitlines():
            if not line.strip():
                if cur:
                    blocs.append(cur)
                    cur = {}
                continue
            k, _, v = line.partition(" ")
            cur[k] = v
        if cur:
            blocs.append(cur)
        branches = {}
        for l in (_git(work, "for-each-ref", "--format=%(refname:short)\t%(upstream:short)\t%(upstream:track)", "refs/heads") or "").splitlines():
            p = l.split("\t")
            if len(p) >= 3:
                branches[p[0]] = (p[1], p[2])
        remotes = set((_git(work, "for-each-ref", "--format=%(refname:short)", "refs/remotes") or "").split())
        base = next((x for x in ("origin/main", "origin/master") if x in remotes), None)
        nom = os.path.basename(os.path.dirname(gitdir)) if gitdir.endswith("/.git") else os.path.basename(gitdir)
        depots_out.append({"nom": nom, "chemin": work, "base": base, "worktrees": len([b for b in blocs if "bare" not in b])})
        for b in blocs:
            if "bare" not in b:
                taches.append((nom, work, b, agents_wt, remotes, base, branches))
    with ThreadPoolExecutor(max_workers=6) as ex:
        items = list(ex.map(lambda a: _inspecter(*a), taches))
    items.sort(key=lambda i: (WT_ORDRE[i["statut"]], -(i["non_pousses"] + i["dirty"]), -(i["dernier_ts"] or 0)))
    resume = {k: 0 for k in WT_ORDRE}
    for i in items:
        resume[i["statut"]] += 1
    return {"t": int(time.time()), "resume": resume, "depots": depots_out, "items": items}


class Cache:
    """Calcul lent, relancé en arrière-plan quand il est plus vieux que `every` s ; le 1er appel attend."""

    def __init__(self, fn, every):
        self.fn, self.every, self.data, self.t = fn, every, None, 0.0
        self.lock = threading.Lock()
        self.busy = False

    def _run(self):
        if not self.lock.acquire(blocking=False):
            return
        self.busy = True
        try:
            self.data, self.t = self.fn(), time.time()
        except Exception as e:
            print("agent-view :", self.fn.__name__, "->", e, file=sys.stderr)
        finally:
            self.busy = False
            self.lock.release()

    def get(self):
        if self.data is None:
            self._run()
            if self.data is None:               # un autre fil calcule déjà : on attend la fin
                with self.lock:
                    pass
        elif time.time() - self.t > self.every and not self.busy:
            threading.Thread(target=self._run, daemon=True).start()
        if self.data is None:
            return {"error": "indisponible"}
        return dict(self.data, age=int(time.time() - self.t), refreshing=self.busy)


