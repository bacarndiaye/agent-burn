*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--txt);font:14px/1.45 ui-sans-serif,system-ui,sans-serif}
header{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:14px 22px;border-bottom:1px solid var(--line);flex-wrap:wrap}
header h1{font-size:17px;margin:0}header nav a{color:var(--dim);margin-left:14px;text-decoration:none}header nav a:hover{color:var(--txt)}
#maj{color:var(--dim);font-size:12px}
main{padding:16px 22px;display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(340px,1fr))}
.panel{background:var(--piece);border:1px solid var(--line);border-radius:12px;padding:12px 16px;min-width:0}
.panel.large{grid-column:1/-1}
.panel h2{font-size:13px;color:var(--dim);font-weight:600;margin:0 0 10px;text-transform:uppercase;letter-spacing:.04em}
#cards{display:flex;gap:12px;flex-wrap:wrap}
.card{background:var(--piece);border:1px solid var(--line);border-left:4px solid var(--c);border-radius:12px;padding:10px 16px;min-width:170px}
.card b{font-size:24px;display:block;line-height:1.15}.card span{color:var(--dim);font-size:12px}
table{width:100%;border-collapse:collapse}th{text-align:left;color:var(--dim);font-weight:500;font-size:12px;padding:6px 8px;border-bottom:1px solid var(--line)}
td{padding:6px 8px;border-bottom:1px solid var(--line);font-size:13px}tr:last-child td{border-bottom:0}
.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}.dim{color:var(--dim)}
.chip{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11.5px;font-weight:600;color:var(--c);
 background:color-mix(in srgb,var(--c) 16%,transparent);border:1px solid color-mix(in srgb,var(--c) 45%,transparent)}
.leg{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--dim);margin-top:6px}.leg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}
svg{width:100%;height:150px;display:block}
