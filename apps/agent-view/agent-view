 <footer id="pied"></footer>
</main>
<script>
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const fmN=n=>n>=1e9?(n/1e9).toFixed(2).replace(".",",")+" Md":n>=1e6?(n/1e6).toFixed(1).replace(".",",")+" M":n>=1e3?Math.round(n/1e3)+" k":String(n||0);
const fmU=n=>(n==null?"—":Math.round(n).toLocaleString("fr-FR")+" $");
const pc=n=>n==null?"—":Math.round(n)+" %";
function ago(s){if(s==null)return"—";if(s<90)return s+" s";if(s<5400)return Math.round(s/60)+" min";return Math.round(s/3600)+" h"}
function quand(ms){if(!ms)return"?";const d=new Date(ms);return d.toLocaleDateString("fr-FR",{weekday:"short",day:"2-digit",month:"2-digit"})+" "+d.toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"})}
function barres(svg,leg,jours,cl,champ,fmt){const W=700,H=150,n=jours.length;if(!n){$(svg).innerHTML="";return}
 const tot=j=>cl.reduce((s,c)=>s+(j[champ][c.cle]||0),0),max=Math.max(1e-9,...jours.map(tot)),bw=W/n;
 $(svg).innerHTML=jours.map((j,i)=>{let y=H;return cl.map(c=>{const v=j[champ][c.cle]||0,h=v/max*(H-4);y-=h;
  return h>0?`<rect x="${(i*bw+1).toFixed(1)}" y="${y.toFixed(1)}" width="${Math.max(1,bw-2).toFixed(1)}" height="${h.toFixed(1)}" fill="${esc(c.couleur)}"><title>${esc(j.d)} · ${esc(c.nom)} : ${fmt(v)}</title></rect>`:""}).join("")}).join("");
 $(leg).innerHTML=cl.map(c=>`<span><i style="background:${esc(c.couleur)}"></i>${esc(c.nom)}</span>`).join("")+`<span>max ${fmt(max)} / jour · ${n} jours</span>`}
function render(A){const C=A.conso,D=C.data,Q=(A.quotas.data||{}),k=A.eur_par_usd;
 const etat=[];if(!A.binaire)etat.push("agent-burn introuvable");if(C.calcul)etat.push("calcul en cours…");
 if(D)etat.push("données d'il y a "+ago(C.age));$("maj").textContent=etat.join(" · ")||"en attente";
 const errs=[C.erreur,A.quotas.erreur].filter(Boolean);
 if(!D){$("cards").innerHTML=`<div class="vide">${A.binaire?(C.erreur?`<span class="err">indisponible : ${esc(C.erreur)}</span>`:"Premier calcul en cours (quelques dizaines de secondes sur un gros historique)…"):"agent-burn introuvable : définir AV_AGENT_BURN ou installer ~/.local/bin/agent-burn (scripts/install.sh)."}</div>`}
 else{const pg=D.part_gratuite,col=p=>p==null?"var(--dim)":p>=60?"var(--ok)":p>=35?"var(--warn)":"var(--bad)";
  const cards=[["var(--ok)",pc(pg.periode),"part gratuite (tokens, période)"],["var(--ok)",pc(pg.j7)+" · "+pc(pg.auj),"part gratuite 7 j · aujourd'hui"],
   ["var(--ok)","≈ "+fmU(D.evite_usd),"coût évité (au prix moyen du token payant)"],["#ec4899",fmU(D.tot_cout.payant),"payant (équiv. API, période)"],
   ["#f59e0b",fmU(D.tot_cout.abonnement),"abonnement (équiv. API, période)"],["var(--dim)",fmU(D.total_usd),"total ≈ "+Math.round(D.total_usd*k).toLocaleString("fr-FR")+" €"]];
  $("cards").innerHTML=cards.map(([c,v,l],i)=>`<div class="card" style="--c:${c}"><b style="${i<2?"color:"+col(i?pg.j7:pg.periode):""}">${esc(v)}</b><span>${esc(l)}</span></div>`).join("");
  barres("gcout","lcout",D.jours,D.classes.filter(c=>c.cle!=="gratuit"),"cout",fmU);
  barres("gtok","ltok",D.jours,D.classes,"tokens",fmN);
  const byc=Object.fromEntries(D.classes.map(c=>[c.cle,c]));
  $("top").innerHTML=`<table><thead><tr><th>Modèle</th><th>Classe</th><th class="num">Tokens</th><th class="num">Coût équiv. API</th></tr></thead><tbody>`+
   D.top.map(m=>`<tr><td>${esc(m.modele)}</td><td><span class="chip" style="--c:${esc((byc[m.classe]||{}).couleur||"#8089a0")}">${esc(m.classe)}</span></td><td class="num">${fmN(m.tokens)}</td><td class="num">${m.cout?fmU(m.cout):"0 $"}</td></tr>`).join("")+"</tbody></table>";
  $("abos").innerHTML=D.abonnements.length?`<table><thead><tr><th>Outil</th><th>Formule</th><th class="num">Usage période</th><th class="num">Valeur / mois</th></tr></thead><tbody>`+
   D.abonnements.map(a=>`<tr><td>${esc(a.agent)}</td><td>${esc(a.plan||"?")}${a.prix_mois?` <span class="dim">${esc(a.prix_mois)} $/mois</span>`:""}</td><td class="num">${fmU(a.usage_periode)}</td>
    <td class="num">${a.valeur_mois?fmU(a.valeur_mois)+` <span class="dim">×${Number(a.multiple||0).toFixed(1).replace(".",",")}</span>`:"—"}</td></tr>`).join("")+"</tbody></table>":'<div class="vide">Aucun abonnement détecté.</div>'}
 const rc=D?D.resets_claude:{};
 $("quotas").innerHTML=["claude","codex","glm"].map(a=>{const e=Q[a]||{};if(!A.quotas.data)return"";
  if(e.erreur)return `<div class="q"><div class="l"><b>${esc(a)}</b><span class="dim">${esc(e.erreur)}</span></div></div>`;
  return (e.fenetres||[]).map(f=>{const u=Math.max(0,Math.min(100,f.utilise||0)),c=u>=90?"var(--bad)":u>=70?"var(--warn)":"var(--ok)";
   const r=(a==="claude"&&rc&&rc[f.nom])||f.reset_ms;
   return `<div class="q"><div class="l"><span><b>${esc(a)}</b> · ${esc(f.nom)}</span><span>${u.toFixed(0)} % · remise à zéro ${esc(quand(r))}</span></div>
    <div class="t" title="trait : temps écoulé de la fenêtre (${Math.round(f.ecoule||0)} %)"><div class="u" style="width:${u}%;background:${c}"></div><div class="e" style="left:${Math.min(100,f.ecoule||0)}%"></div></div></div>`}).join("")}).join("")||'<div class="vide">Chargement des limites…</div>';
 $("pied").innerHTML=`Source : <b>agent-burn</b> (journaux locaux ; coût = équivalent API, pas une facture). Classes : <b>gratuit</b> = modèles servis par un moteur local (table « modeles » de la configuration),
  <b>abonnement</b> / <b>payant</b> = préfixes de modèle (« classes »). Les modèles locaux sont comptés à 0 par les <code>pricingOverrides</code> d'agent-burn.
  Limites : rafraîchies toutes les 2 min ; consommation : toutes les 10 min.`+(errs.length?`<div class="err">${errs.map(esc).join(" · ")}</div>`:"")}
async function charger(){try{const r=await fetch("/api/conso");render(await r.json())}catch(e){$("maj").textContent="serveur injoignable"}}
charger();setInterval(charger,15000);
</script></body></html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, ctype, body, csp=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cache-Control", "no-store")
        if csp:
            self.send_header("Content-Security-Policy", csp)
        self.end_headers()
        self.wfile.write(body)

    def _page(self, page):
        """Page HTML avec CSP stricte : seuls nos <script> (nonce de la réponse) s'exécutent ; un gestionnaire
        d'évènement injecté dans le DOM (onerror=…) est bloqué même si un échappement venait à manquer."""
        nonce = secrets.token_urlsafe(18)
        csp = (f"default-src 'none'; script-src 'nonce-{nonce}'; style-src 'unsafe-inline'; img-src 'self' data:; "
               "connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
        page = (page.replace("__TITRE__", html.escape(CONF["titre"]))
                .replace("__PIECES_JSON__", json.dumps([list(p) for p in PIECES], ensure_ascii=False).replace("</", "<\\/")))
        self._send(200, "text/html; charset=utf-8", page.replace("<script>", f'<script nonce="{nonce}">').encode(), csp)

    def _hote_ok(self):
        return bool(HOTE_OK.match(self.headers.get("Host", "").rsplit(":", 1)[0]))

    def do_GET(self):
        if not self._hote_ok():                 # anti DNS-rebinding : un nom de domaine étranger ne lit rien
            return self._send(403, "text/plain", b"403")
        u = urlparse(self.path)
        q = {k: v[0] for k, v in parse_qs(u.query).items()}
        if u.path == "/api/pair":
            self._send(200, "application/json; charset=utf-8", json.dumps(api_pair(q.get("a", ""), q.get("b", "")), ensure_ascii=False).encode())
        elif u.path == "/api/agent":
            self._send(200, "application/json; charset=utf-8", json.dumps(api_agent(q.get("id", "")), ensure_ascii=False).encode())
        elif u.path == "/api/thread":
            self._send(200, "application/json; charset=utf-8", json.dumps(api_thread(q.get("name", "")), ensure_ascii=False).encode())
        elif self.path == "/api/state":
            st = cached_state()
            st["me"] = os.environ.get("AGENT_ID", "")
            self._send(200, "application/json; charset=utf-8", json.dumps(st, ensure_ascii=False).encode())
        elif self.path == "/api/costs":
            c = COUTS.get()
            if "error" not in c:
                c["burn"] = resume_burn()           # part gratuite d'après agent-burn quand il a rendu (sinon ancien calcul)
            self._send(200, "application/json; charset=utf-8", json.dumps(c, ensure_ascii=False).encode())
        elif self.path == "/api/conso":
            self._send(200, "application/json; charset=utf-8", json.dumps(api_conso(), ensure_ascii=False).encode())
        elif self.path in ("/conso", "/conso/"):
            self._page(CONSO_PAGE)
        elif self.path == "/api/worktrees":
            self._send(200, "application/json; charset=utf-8", json.dumps(WORKTREES.get(), ensure_ascii=False).encode())
        elif self.path == "/api/liens":
            self._send(200, "application/json; charset=utf-8", json.dumps(LIENS.get(), ensure_ascii=False).encode())
        elif self.path in ("/liens", "/liens/"):
            self._page(LIENS_PAGE)
        elif self.path in ("/worktrees", "/worktrees/"):
            self._page(WT_PAGE)
        elif self.path in ("/", "/index.html"):
            self._page(PAGE)
        else:
            self._send(404, "text/plain", b"404")

    def do_POST(self):
        """Écritures sur le bus (réacheminer / classer des messages de destinataires finis).

        Garde-fous : nom d'hôte privé (anti DNS-rebinding), en-tête X-AV-Action (impose un preflight
        CORS que ce serveur ne satisfait jamais), JSON, Origin identique à Host."""
        hote = self.headers.get("Host", "")
        origine = self.headers.get("Origin", "")
        if (not self._hote_ok() or self.headers.get("X-AV-Action") != "1"
                or not self.headers.get("Content-Type", "").startswith("application/json")
                or (origine and origine.split("://", 1)[-1] != hote)):
            return self._send(403, "text/plain", b"403")
        try:
            n = int(self.headers.get("Content-Length", "0"))
            data = json.loads(self.rfile.read(min(n, 200000)) or b"{}")
            keys = data.get("keys")
            if not isinstance(keys, list):
                raise ValueError("keys")
        except (ValueError, AttributeError):
            return self._send(400, "text/plain", b"400")
        if self.path == "/api/reroute":
            res = action_bus("reroute", keys, str(data.get("to", "")))
        elif self.path == "/api/archive":
            res = action_bus("archive", keys)
        else:
            return self._send(404, "text/plain", b"404")
        LIENS._run()
        self._send(200, "application/json; charset=utf-8", json.dumps(res, ensure_ascii=False).encode())


def fmt_tok(n):
    return f"{n / 1e9:.2f} Md" if n >= 1e9 else f"{n / 1e6:.1f} M" if n >= 1e6 else f"{n / 1e3:.0f} k" if n >= 1e3 else str(n)


def render_costs(c):
    L = [f"{'moteur':22}{'sess':>6}{'sortie':>10}{'entrée':>10}{'cache lu':>11}{'$ Opus':>9}{'€ Opus':>9}{'auj. €':>8}{'7 j €':>8}"]
    for e in c["moteurs"] + [dict(c["total"], name="TOTAL")]:
        L.append(f"{e['name']:22}{e['sess']:6}{fmt_tok(e['out']):>10}{fmt_tok(e['inp']):>10}{fmt_tok(e['cr']):>11}"
                 f"{e['usd']:9.0f}{e['eur']:9.0f}{e['today_usd'] * c['eur_par_usd']:8.0f}{e['d7_usd'] * c['eur_par_usd']:8.0f}")
    t = c["tarif"]
    L.append(f"tarif Opus : {t['in']}/{t['out']} $ par M (entrée/sortie), cache écrit {t['cw']}, lu {t['cr']} ; 1 $ = {c['eur_par_usd']} €")
    return "\n".join(L)


def render_worktrees(w, tout=False):
    NOM = {"jamais": "JAMAIS POUSSÉ", "retard": "en retard", "modifs": "modifs", "sansdistant": "sans distant",
           "absent": "absent", "ok": "à jour"}
    L = ["  ".join(f"{NOM[k]} : {v}" for k, v in w["resume"].items())]
    for i in w["items"]:
        if i["statut"] == "ok" and not tout:
            continue
        L.append(f"{NOM[i['statut']]:15}{i['depot']:12}{i['court'][:36]:36} {str(i['branche'] or '(détachée)')[:34]:34}"
                 f" non poussés={i['non_pousses']:<3} modifs={i['dirty']:<3} {i['dernier_msg'][:50]}")
    return "\n".join(L)


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "texte"
    if mode == "serve":
        port = int(sys.argv[2]) if len(sys.argv) > 2 else 8765
        srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
        _CACHE["req"] = time.time()
        threading.Thread(target=cache_loop, daemon=True).start()
        print(f"agent-view : http://127.0.0.1:{port}  (Ctrl-C pour arrêter)")
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
    elif mode == "live":
        every = int(sys.argv[2]) if len(sys.argv) > 2 else 2
        while True:
            print("\033[2J\033[H" + render_text(collect()), flush=True)
            try:
                time.sleep(every)
            except KeyboardInterrupt:
                print()
                return
    elif mode == "couts":
        print(render_costs(collect_costs()))
    elif mode == "conso":
        if binaire_burn():
            print("agent-view : calcul agent-burn en cours (peut prendre une minute sur un gros historique)…", file=sys.stderr)
        CONSO.get(attendre=True)
        QUOTAS.get(attendre=True)
        print(render_conso(api_conso()))
    elif mode == "liens":
        print(render_liens(collect_liens()))
    elif mode == "worktrees":
        print(render_worktrees(collect_worktrees(), tout="--tout" in sys.argv))
    else:
        print(render_text(collect()))


if __name__ == "__main__":
    main()
