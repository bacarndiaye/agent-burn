# ------------------------------------------------ liens : hiérarchie, flux, attentes --

SEUIL_LENT = 1800       # non lu depuis plus de 30 min chez un agent vivant : il ne lit pas
SEUIL_BLOQUE = 1800     # développeur vivant en veille depuis plus de 30 min alors que son superviseur l'attend
FENETRE_LAT = 48 * 3600  # délais de lecture : messages lus dans les 48 dernières heures
LU_MAX_S = float(os.environ.get("AV_LU_JOURS", "7")) * 86400   # messages déjà lus plus vieux : ignorés (coût)
_NOM_OK = re.compile(r"^[\w.#:@+\-]+$")
HOTE_OK = re.compile(r"^(localhost|127\.\d+\.\d+\.\d+|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+)$")


def _registre():
    regs = {}
    d = BUS / "agents"
    if d.is_dir():
        for f in d.iterdir():
            if ".tmp." in f.name or f.name.endswith(".tmp") or not f.is_file():
                continue
            try:
                regs[f.name] = dict(l.split("=", 1) for l in lire(f).splitlines() if "=" in l)
            except OSError:
                continue
    return regs


def _vivant_reg(regs, i):
    r = regs.get(i)
    return bool(r) and reg_alive(r)


def _entete(raw):
    head, _, body = raw.partition("\n\n")
    return dict(l.split("=", 1) for l in head.splitlines() if "=" in l), body


def _scan_msgs(now, plein=False):
    """Tous les messages du bus : non lus (inbox/<id>/*.msg) et lus (inbox/<id>/lu/*.msg).

    Le délai de lecture est ctime − mtime : `mv` vers lu/ change le ctime, pas le mtime."""
    root = BUS / "inbox"
    out = []
    if not root.is_dir():
        return out
    for f in list(root.glob("*/*.msg")) + list(root.glob("*/lu/*.msg")):
        try:
            st = f.stat()
            if f.parent.name == "lu" and now - st.st_mtime > LU_MAX_S:
                continue                     # messages lus anciens : hors statistiques (AV_LU_JOURS)
            with open(f, errors="replace") as fh:
                raw = fh.read(60000 if plein else 1500)
        except OSError:
            continue
        champs, body = _entete(raw)
        lu = f.parent.name == "lu"
        inbox = f.parent.parent.name if lu else f.parent.name
        classe = "classe_par" in champs
        out.append({"key": inbox + "/" + ("lu/" if lu else "") + f.name, "from": champs.get("de", "?"), "to": inbox,
                    "when": champs.get("quand", ""), "read": lu, "sent": st.st_mtime, "ago": int(now - st.st_mtime),
                    "lat": int(st.st_ctime - st.st_mtime) if lu and not classe and st.st_ctime - st.st_mtime > 1 else None,
                    "classe": classe,
                    "text": body.strip() if plein else " ".join(body.split())[:160]})
    return out


def collect_liens():
    """Qui dirige qui (parent du registre), flux par paire, qui attend quoi, et ce qui coince.

    « Attend » est DÉRIVÉ, pas déclaré : un message non lu de A vers B fait attendre A sur B ;
    un superviseur vivant attend ses développeurs vivants ; un développeur vivant dont le parent
    n'est plus là n'est dirigé par personne."""
    st = cached_state()
    now = time.time()
    by = {a["id"]: a for a in st["agents"]}
    vivant = lambda i: bool(by.get(i) and by[i]["alive"])
    msgs = _scan_msgs(now)
    flux = {}
    for m in msgs:
        e = flux.setdefault((m["from"], m["to"]), {"from": m["from"], "to": m["to"], "n": 0, "unread": 0, "ago": None, "last": ""})
        e["n"] += 1
        e["unread"] += 0 if m["read"] else 1
        if e["ago"] is None or m["ago"] < e["ago"]:
            e["ago"], e["last"] = m["ago"], m["text"]
    unread_in, unread_out, oldest, lat = {}, {}, {}, {}
    for m in msgs:
        if not m["read"]:
            unread_in[m["to"]] = unread_in.get(m["to"], 0) + 1
            unread_out[m["from"]] = unread_out.get(m["from"], 0) + 1
            oldest[m["to"]] = max(oldest.get(m["to"], 0), m["ago"])
        elif m["lat"] is not None and m["ago"] - m["lat"] < FENETRE_LAT:
            lat.setdefault(m["to"], []).append(m["lat"])
    ids = set(by)
    for m in msgs:
        ids.add(m["from"]); ids.add(m["to"])
    for a in st["agents"]:
        if a["parent"]:
            ids.add(a["parent"])
    nodes = []
    for i in sorted(ids):
        a = by.get(i)
        l = lat.get(i)
        nodes.append({"id": i, "known": a is not None,
                      "role": (a or {}).get("role") or ("mgr" if i.startswith("mgr") else "sup" if i.startswith("sup") else "dev" if i.startswith("dev") else "?"),
                      "harness": (a or {}).get("harness", "?"), "state": (a or {}).get("state", "absent"),
                      "classe": (a or {}).get("classe", "mgr" if i.startswith("mgr") else "sup" if i.startswith("sup") else "dev"),
                      "parent": (a or {}).get("parent", ""), "wt": (a or {}).get("wt_short", ""),
                      "activity_ago": (a or {}).get("activity_ago"),
                      "unread_in": unread_in.get(i, 0), "unread_out": unread_out.get(i, 0),
                      "oldest_unread": oldest.get(i), "lat_med": int(statistics.median(l)) if l else None, "lat_n": len(l or [])})
    waits = []
    for m in msgs:
        if not m["read"] and vivant(m["to"]) and (vivant(m["from"]) or m["from"].startswith("sup")):
            waits.append({"kind": "non_lu", "who": m["from"], "on": m["to"], "ago": m["ago"], "text": m["text"]})
    kids = {}
    for a in st["agents"]:
        if a["parent"] and a["alive"]:
            kids.setdefault(a["parent"], []).append(a["id"])
    for p, ks in kids.items():
        if vivant(p):
            waits.append({"kind": "equipe", "who": p, "on": ", ".join(sorted(ks)), "n": len(ks),
                          "actifs": sum(1 for k in ks if by[k]["state"] == "action")})
    for a in st["agents"]:
        if a["alive"] and a["role"] == "dev" and not vivant(a["parent"]):
            waits.append({"kind": "orphelin", "who": a["id"], "on": a["parent"] or "(aucun parent)"})
    waits.sort(key=lambda w: ({"non_lu": 0, "orphelin": 1, "equipe": 2}[w["kind"]], w.get("ago", 0)))

    cibles = sorted(a["id"] for a in st["agents"] if a["alive"] and a["role"] == "sup")
    perdus, lents = {}, {}
    for m in msgs:
        if m["read"]:
            continue
        if not vivant(m["to"]):
            g = perdus.setdefault(m["to"], {"to": m["to"], "n": 0, "oldest": 0, "froms": {}, "keys": []})
        elif m["ago"] >= SEUIL_LENT:
            g = lents.setdefault(m["to"], {"who": m["to"], "n": 0, "oldest": 0, "froms": {}, "keys": []})
        else:
            continue
        g["n"] += 1
        g["oldest"] = max(g["oldest"], m["ago"])
        g["froms"][m["from"]] = g["froms"].get(m["from"], 0) + 1
        g["keys"].append(m["key"])
    liste_perdus = []
    for g in perdus.values():
        p = by.get(g["to"], {}).get("parent", "")
        defaut = p if vivant(p) else next((by[s]["parent"] for s in g["froms"] if s in by and vivant(by[s]["parent"])), "")
        liste_perdus.append({"to": g["to"], "n": g["n"], "oldest": g["oldest"], "keys": g["keys"], "defaut": defaut,
                             "froms": sorted(g["froms"], key=lambda s: -g["froms"][s])[:5]})
    liste_perdus.sort(key=lambda g: -g["n"])
    liste_lents = []
    for g in lents.values():
        a = by.get(g["who"], {})
        liste_lents.append({"who": g["who"], "n": g["n"], "oldest": g["oldest"], "state": a.get("state", "?"),
                            "harness": a.get("harness", "?"), "idle": a.get("activity_ago"),
                            "froms": sorted(g["froms"], key=lambda s: -g["froms"][s])[:5]})
    liste_lents.sort(key=lambda g: -g["oldest"])
    bloques = []
    for a in st["agents"]:
        if a["alive"] and a["role"] == "dev" and a["state"] == "veille" and (a["activity_ago"] or 0) > SEUIL_BLOQUE and vivant(a["parent"]):
            bloques.append({"who": a["parent"], "on": a["id"], "idle": a["activity_ago"],
                            "unread": unread_in.get(a["id"], 0), "oldest_unread": oldest.get(a["id"])})
    bloques.sort(key=lambda b: -b["idle"])
    delais = sorted(({"id": i, "med": int(statistics.median(v)), "max": max(v), "n": len(v),
                      "state": by.get(i, {}).get("state", "absent")} for i, v in lat.items() if v),
                    key=lambda x: -x["med"])[:12]
    return {"now": int(now), "nodes": nodes, "flux": sorted(flux.values(), key=lambda e: (-e["unread"], e["ago"] or 0)),
            "waits": waits, "nb_msgs": len(msgs), "perdus": liste_perdus, "lents": liste_lents, "bloques": bloques,
            "delais": delais, "cibles": cibles,
            "resume": {"perdus": sum(g["n"] for g in liste_perdus), "agents_perdus": len(liste_perdus),
                       "lents": sum(g["n"] for g in liste_lents), "agents_lents": len(liste_lents),
                       "bloques": len(bloques), "alertes": len(liste_perdus) + len(liste_lents) + len(bloques)}}


LIENS = Cache(collect_liens, 5)


def _entrees_fils(i, limite=15):
    out = []
    d = BUS / "threads"
    if not d.is_dir():
        return out
    for f in d.glob("*.md"):
        try:
            txt = lire(f)
        except OSError:
            continue
        for bloc in re.split(r"(?m)^### ", txt)[1:]:
            tete, _, corps = bloc.partition("\n")
            if tete.startswith(i + " "):
                out.append({"thread": f.stem, "when": tete.split("—", 1)[-1].strip(), "text": corps.strip()[:1500]})
    out.sort(key=lambda e: e["when"], reverse=True)
    return out[:limite]


def api_pair(a, b):
    ms = [m for m in _scan_msgs(time.time(), plein=True) if (m["from"], m["to"]) in ((a, b), (b, a))]
    ms.sort(key=lambda m: m["sent"])
    return {"a": a, "b": b, "messages": ms[-60:]}


def api_agent(i):
    st = cached_state()
    a = next((x for x in st["agents"] if x["id"] == i), None)
    ms = _scan_msgs(time.time(), plein=True)
    recus = sorted((m for m in ms if m["to"] == i), key=lambda m: (m["read"], -m["sent"]))[:30]
    envoyes = sorted((m for m in ms if m["from"] == i), key=lambda m: -m["sent"])[:30]
    return {"id": i, "agent": a, "recus": recus, "envoyes": envoyes, "fils": _entrees_fils(i),
            "nb_recus": sum(1 for m in ms if m["to"] == i), "nb_envoyes": sum(1 for m in ms if m["from"] == i)}


def api_thread(name):
    if not _NOM_OK.match(name) or name in (".", ".."):
        return {"error": "nom invalide"}
    try:
        return {"name": name, "text": lire(BUS / "threads" / (name + ".md"))[:60000]}
    except OSError:
        return {"error": "introuvable"}


def _cle_ok(key):
    parts = key.split("/")
    if len(parts) not in (2, 3) or any(not _NOM_OK.match(p) or p in (".", "..") for p in parts):
        return None
    if len(parts) == 3 and parts[1] != "lu":
        return None
    return BUS / "inbox" / Path(*parts) if parts[-1].endswith(".msg") else None


def action_bus(kind, keys, to=""):
    """Réachemine (ou classe sans suite) des messages NON LUS dont le destinataire n'est plus vivant.

    Seule écriture d'agent-view sur le bus. Le message d'origine est conservé dans lu/ (marqué
    `classe_par`, donc hors des statistiques de délai) ; rien n'est supprimé."""
    regs = _registre()
    if kind == "reroute" and not _vivant_reg(regs, to):
        return {"ok": 0, "erreurs": [f"destinataire « {to} » absent ou fini"]}
    ok, erreurs, owners = 0, [], set()
    stamp = time.strftime("%Y%m%dT%H%M%S")
    for key in keys[:500]:
        p = _cle_ok(key) if isinstance(key, str) else None
        if p is None or p.parent.name == "lu" or not p.is_file():
            erreurs.append(f"{key} : introuvable ou déjà lu")
            continue
        owner = p.parent.name
        if _vivant_reg(regs, owner):
            erreurs.append(f"{key} : {owner} est vivant, il le lira lui-même")
            continue
        try:
            st0 = p.stat()
            champs, body = _entete(lire(p))
            if kind == "reroute":
                d = BUS / "inbox" / to
                d.mkdir(parents=True, exist_ok=True)
                dst = d / f"{p.stem}-rr{random.randrange(10 ** 5)}.msg"
                tmp = d / (dst.name + ".tmp")
                tmp.write_text(f"de={champs.get('de', '?')}\nà={to}\nquand={champs.get('quand', '')}\n"
                               f"réacheminé_de={owner}\nréacheminé_le={stamp}\n\n"
                               f"(réacheminé par agent-view : adressé à {owner}, qui n'est plus actif)\n{body.strip()}\n")
                os.replace(tmp, dst)
            lu = p.parent / "lu"
            lu.mkdir(exist_ok=True)
            tete = "".join(f"{k}={v}\n" for k, v in champs.items()) + f"classe_par=agent-view\nclasse_le={stamp}\n"
            (lu / p.name).write_text(f"{tete}\n{body.strip()}\n")
            os.utime(lu / p.name, (st0.st_atime, st0.st_mtime))   # garde la date d'envoi (ordre, ancienneté)
            p.unlink()
            ok += 1
            owners.add(owner)
        except OSError as e:
            erreurs.append(f"{key} : {e}")
    try:
        with open(BUS / "av-actions.log", "a") as lg:
            lg.write(f"{stamp}\t{kind}\t{to or '-'}\t{ok}/{len(keys)}\t{','.join(sorted(owners))}\n")
    except OSError:
        pass
    return {"ok": ok, "erreurs": erreurs[:20]}


def render_liens(d):
    out = []
    kids = {}
    for n in d["nodes"]:
        kids.setdefault(n["parent"], []).append(n)
    ids = {n["id"] for n in d["nodes"]}
    racines = [n for n in d["nodes"] if not n["parent"] or n["parent"] not in ids]
    out.append(f'{C["b"]}Qui dirige qui{C["0"]}')

    def noeud(n, prof):
        if n["state"] in ("fini", "absent") and not (n["unread_in"] or n["unread_out"]) and not kids.get(n["id"]):
            return
        col = C.get(n["state"], C["d"])
        badge = (f' ✉ {n["unread_in"]} non lu(s)' if n["unread_in"] else "") + (f' ↗ {n["unread_out"]} en attente de lecture' if n["unread_out"] else "")
        out.append(f'{"  " * prof}{col}{DOT.get(n["state"], "?")}{C["0"]} {n["id"]} {C["d"]}[{n["harness"]}, {n["state"]}]{badge}{C["0"]}')
        for k in sorted(kids.get(n["id"], []), key=lambda x: x["id"]):
            noeud(k, prof + 1)

    for r in sorted(racines, key=lambda x: (x["role"] not in ("mgr", "sup"), x["role"] != "mgr", x["id"])):
        if r["role"] in ("sup", "mgr") or kids.get(r["id"]):
            noeud(r, 0)
    sans = [r for r in racines if r["role"] not in ("sup", "mgr") and not kids.get(r["id"])
            and (r["state"] not in ("fini", "absent") or r["unread_in"] or r["unread_out"])]
    if sans:
        out.append(f'{C["d"]}Sans superviseur déclaré{C["0"]}')
        for r in sorted(sans, key=lambda x: x["id"]):
            noeud(r, 1)
    out.append("")
    out.append(f'{C["b"]}À traiter{C["0"]}')
    r = d["resume"]
    if not r["alertes"]:
        out.append("  rien")
    for g in d["perdus"]:
        out.append(f'  ✉ {g["n"]} message(s) pour {g["to"]} (fini), le plus ancien il y a {ago_txt(g["oldest"])}'
                   + (f' → suggestion : {g["defaut"]}' if g["defaut"] else ""))
    for g in d["lents"]:
        out.append(f'  🐌 {g["who"]} ({g["state"]}) n\'a pas lu {g["n"]} message(s), le plus ancien il y a {ago_txt(g["oldest"])}')
    for b in d["bloques"]:
        out.append(f'  ⏸ {b["who"]} attend {b["on"]}, en veille depuis {ago_txt(b["idle"])}')
    out.append("")
    out.append(f'{C["b"]}Délai de lecture (médiane, 48 h){C["0"]}')
    for e in d["delais"][:8]:
        out.append(f'  {e["id"]}  {ago_txt(e["med"])}  (max {ago_txt(e["max"])}, {e["n"]} msg)')
    out.append("")
    out.append(f'{C["b"]}En attente{C["0"]}')
    if not d["waits"]:
        out.append("  rien")
    for w in d["waits"]:
        if w["kind"] == "non_lu":
            out.append(f'  ✉ {w["who"]} attend {w["on"]} — il y a {ago_txt(w["ago"])}')
        elif w["kind"] == "equipe":
            out.append(f'  ⏳ {w["who"]} dirige {w["n"]} dév. vivant(s), dont {w["actifs"]} en action')
        else:
            out.append(f'  ⚠ {w["who"]} n\'est dirigé par personne de vivant (parent : {w["on"]})')
    out.append("")
    out.append(f'{C["b"]}Flux (de → à){C["0"]}')
    for e in d["flux"][:25]:
        out.append(f'  {e["from"]} → {e["to"]}  ×{e["n"]}' + (f'  {e["unread"]} non lu(s)' if e["unread"] else "") + f'  il y a {ago_txt(e["ago"] or 0)}')
    return pur_lignes(out)


def pur_lignes(lignes):
    """Assemble des lignes de terminal : retire les caractères de contrôle venus des données (pas nos couleurs)."""
    return "\n".join(re.sub(r"\x1b(?!\[[0-9;]*m)", "", re.sub(r"[\x00-\x08\x0b-\x1a\x1c-\x1f\x7f-\x9f]", "", l)) for l in lignes)


