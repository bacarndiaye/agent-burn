   <rect x="${p.x}" y="${p.y}" width="${p.w}" height="${BH}" rx="6"/><text x="${p.x+8}" y="${p.y+BH/2+4}" style="fill:${KC[n.classe]||"var(--txt)"}">${esc(t)}</text>
   <text class="bd" x="${p.x+p.w-6}" y="${p.y+BH/2+4}" text-anchor="end">${bd.join(" ")}</text></g>`)});
 const svg=$("g");svg.setAttribute("width",W);svg.setAttribute("height",H+20);svg.setAttribute("viewBox",`0 0 ${W} ${H+20}`);
 svg.innerHTML=o.join("");
 if(!vis.length)svg.innerHTML=`<text x="20" y="40" class="colt">Rien à afficher pour ce filtre.</text>`}
